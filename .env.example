# Copy to .env and fill in values (local dev). For Docker / Portainer, set the same
# variable names in the stack environment — see docker-compose.yml `environment` list.

# Secret for signing session tokens — change this to something random!
SECRET=change-me-to-something-random-and-long

# Protects the home page (create episode). Guests don't need this — they
# use the room URL + room password directly. Leave blank to disable.
SITE_PASSWORD=

# Port to listen on (production)
PORT=3000
# Dev WebSocket server port (npm run dev). Must match in vite proxy; change if 3001 is busy.
DEV_WS_PORT=3001
HTTPS=false
# Same purpose as HTTPS for cookie `secure` — use if TLS is offloaded and HTTPS env is unset.
FORCE_HTTPS=false
# Path to SQLite database file
DB_PATH=./data/rooms.db

ROOM_MAX_AGE_HOURS=12

# How long (in milliseconds) a room's tabs/text/video/transcript stay in
# memory after the last participant disconnects, before being saved to disk
# and evicted — a reconnect before this fires cancels the save entirely and
# the room just keeps running. Default 10 seconds. Test suites that need to
# see eviction happen quickly should set this much lower (see
# playwright.config.js, which sets it to 200ms for the e2e server only).
ROOM_STATE_GRACE_MS=10000

# Rate limiting (per IP, sliding 1-minute window)
MAX_POSTS_PER_MIN=20          # general POST actions (room create, etc.)
MAX_AUTH_POSTS_PER_MIN=10     # password attempts (?/enter, ?/site_enter)

# Research Assistant (server-side only — never sent to the browser).
# OpenRouter API key. Leave blank to disable the Research Assistant
# endpoint (POST /rec/[slug]/research returns a "not configured" error).
OPENROUTER_API_KEY=
# OpenRouter model id used for research lookups. Defaults to
# a cheap model (openai/gpt-4o-mini) if left blank.
OPENROUTER_MODEL=

# Append live Research Assistant calls (prompt, Focus Turn, raw reply,
# scores) to RESEARCH_EVAL_LOG_DIR as JSONL. Rooms still expire.
# Set to 1/true/yes to enable.
RESEARCH_EVAL_LOG=
RESEARCH_EVAL_LOG_DIR=.research-eval-logs

# Custom / Interpretation Mode uses the Analyrical two-stage prompt in
# src/lib/server/interpretation-mode-prompt.js (lyrics = notes tab,
# Stage 2 = room transcript). Set this only to override that prompt.
RESEARCH_CUSTOM_PROMPT=

# By default only the host can ask the Research Assistant a question or
# remove a research card — guests can view the panel but not create/delete
# entries. Set to 1/true/yes to let every guest ask/remove too. Does NOT
# affect Custom/Interpretation Mode, which stays host-only regardless.
RESEARCH_GUEST_CAN_ASK=